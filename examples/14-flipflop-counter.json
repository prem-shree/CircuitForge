{
  "title": "2-Bit Ripple Counter (D Flip-Flops)",
  "education": {
    "summary": "Each flip-flop feeds its inverted output back to D, so it toggles on every clock edge and divides the frequency by two.",
    "objectives": [
      "Explain edge-triggered storage",
      "Show how toggling divides a clock"
    ],
    "questions": [
      "What is the frequency at Q1 relative to CLK?",
      "Why is this called a ripple counter?"
    ]
  },
