{
  "title": "N-MOSFET Low-Side LED Driver",
  "education": {
    "summary": "A logic-level MOSFET switches the load on the low side; the pull-down keeps the gate defined.",
    "objectives": [
      "Explain gate threshold and logic-level parts",
