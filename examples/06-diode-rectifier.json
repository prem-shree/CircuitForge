{
  "title": "Half-Wave Rectifier with Filter",
  "education": {
    "summary": "The diode passes only one half of the AC waveform; the capacitor holds the peak between pulses.",
    "objectives": [
      "Explain half-wave rectification",
      "Relate ripple to capacitor size and load current"
    ],
    "theory": "Vripple ≈ I·t / C, so a larger capacitor or smaller load current means less ripple.",
