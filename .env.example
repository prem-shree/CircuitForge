# CircuitForge server configuration — copy to .env and fill in.
# These keys are read by the Node server only (server/server.mjs). They are never
# bundled into the browser build and must never be committed.

# --- AI providers (configure at least one to enable /api/ai/*)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# Which provider to use when a request does not name one (default: the first configured).
CF_AI_PROVIDER=anthropic

# Optional model overrides (defaults: claude-sonnet-5 / gpt-4o-mini / gemini-2.0-flash)
CF_ANTHROPIC_MODEL=
CF_OPENAI_MODEL=
CF_GOOGLE_MODEL=

# --- CircuitForge API access
# Comma-separated keys clients must send as "Authorization: Bearer <key>".
# Leave empty to run the API without authentication (local development only).
CF_API_KEYS=

# Port for the reference server.
PORT=8787
