{
  "name": "circuitforge",
  "version": "1.0.0",
  "description": "JSON to ECE circuit schematic generator — static web app, SVG output.",
  "type": "module",
  "private": true,
  "scripts": {
    "symbols": "node scripts/build-symbols.mjs",
    "import-symbols": "node scripts/import-symbols.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "test": "node scripts/build-symbols.mjs && node --test \"tests/*.test.js\"",
    "api": "node server/server.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
