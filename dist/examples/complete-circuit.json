  "version": "1.0",
  "title": "Regulated 555 LED Blinker (complete reference)",
  "description": "Reference circuit that exercises every field CircuitForge understands: a 9 V battery feeds a 5 V linear regulator, a 555 astable drives a MOSFET low-side switch for an LED, and a divider plus test point show measurement annotations. Read this file together with docs/JSON-SCHEMA.md.",
  "metadata": {
    "author": "CircuitForge",
    "created": "2026-09-22",
    "revision": "A",
    "course": "Introductory electronics",
    "difficulty": "beginner",
    "tags": [
      "power supply",
      "555",
      "mosfet",
      "led"
    ],
    "license": "CC0-1.0",
    "notes": "Every value below is a teaching value, not a production design."
  },
  "layout": {
    "grid": 10,
    "componentGap": 60,
    "wireGap": 18,
    "labelGap": 6,
    "sectionGap": 100
  },
  "validation": {
    "supplyVoltage": 5,
    "rules": {
      "OPAMP_SUPPLY_MISSING": "off",
      "LED_NO_CURRENT_LIMIT": "error"
    }
  },
  "simulation": {
    "engine": "ngspice",
    "analyses": [
      {
        "type": "transient",
        "stop": "50ms",
        "step": "10us"
      },
      {
        "type": "operatingPoint"
      }
    ],
    "expected": {
      "frequency": "≈ 1.4 Hz",
      "dutyCycle": "≈ 62 %",
      "ledCurrent": "≈ 9 mA"
    },
    "models": {
      "Q1": "IRLZ44N",
      "U2": "NE555"
    }
  },
  "education": {
    "summary": "Power comes in on the left, is regulated in the middle, and drives the LED on the right. The 555 sets the blink rate; the MOSFET does the switching so the timer never carries the LED current.",
    "objectives": [
      "Read a schematic as power-in, processing, output",
      "Compute a 555 astable frequency from R1, R2 and C3",
      "Size an LED series resistor from the supply and forward voltage",
      "Explain why the regulator needs capacitors on both sides"
    ],
    "theory": "The 555 charges C3 through R1 + R2 and discharges it through R2, so the output is high for 0.693·(R1+R2)·C3 and low for 0.693·R2·C3.",
    "questions": [
      "What happens to the blink rate if C3 is doubled?",
      "Why can the LED not be driven straight from pin 3 without R5?",
      "What is dissipated in U1 at 100 mA load?"
    ],
    "experiments": [
      "Replace R2 with a 100 kΩ potentiometer and watch the duty cycle change.",
      "Measure TP1 with a meter and compare it with the calculated divider output."
    ],
    "troubleshooting": [
      "No blinking: check RST (pin 4) is tied to +5 V.",
      "LED always on: the MOSFET gate may be floating — check R4.",
      "Regulator hot: the input voltage is too high for the load current."
    ]
  },
