{
  "title": "5V Linear Regulator",
  "education": {
    "summary": "A linear regulator turns 9 V into a stable 5 V; the capacitors keep it from oscillating.",
    "objectives": [
      "Explain dropout voltage",
      "Compute regulator dissipation",
      "Say why both capacitors are needed"
    ],
    "theory": "Pdiss = (Vin − Vout) × Iout — at 9 V in, 5 V out and 100 mA that is 0.4 W of heat.",
